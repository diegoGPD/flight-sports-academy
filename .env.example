# Required: password for /admin
ADMIN_PASSWORD=change-me
# Optional: random string used to sign admin sessions (recommended)
SESSION_SECRET=
# Where content, trial requests and uploads are stored. Must be a persistent disk in production.
DATA_DIR=./data
# Optional: POST each new trial request to a webhook (Zapier / Make / Slack incoming webhook)
NOTIFY_WEBHOOK_URL=
PORT=3000
